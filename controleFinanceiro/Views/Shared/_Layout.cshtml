@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - controleFinanceiro</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/controleFinanceiro.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

    <style>
        html, body {
            margin: 0;
            padding: 0;
        }

        .content-wrapper {
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        main {
            flex: 1;
        }

        footer {
            background-color: #f8f9fa;
            padding: 1rem 0;
            border-top: 1px solid #dee2e6;
        }

        /* Navbar */
        .navbar {
            height: 60px;
            overflow: visible;
            align-items: center;
            padding: 0 1rem;
        }

        .navbar-brand {
            display: flex;
            align-items: center;
            height: 60px;
            overflow: visible;
        }

            .navbar-brand img {
                height: 125px;
                max-height: 90px;
            }

        .login-navbar-button {
            background-color: transparent;
            color: #3654ff;
            width: 7.5em;
            height: 2.5em;
            border: 2px solid #3654ff;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.4em;
            text-decoration: none;
            font-weight: 600;
            font-size: 0.85rem;
            transition: all 0.4s ease;
        }

            .login-navbar-button:hover {
                background-color: #3654ff;
                color: #fff;
            }

            .login-navbar-button svg {
                width: 1.2em;
                height: 1.2em;
                transition: all 0.4s ease;
            }

            .login-navbar-button:hover svg {
                transform: translateX(4px);
            }

        .hamburguer-button {
            background-color: #f1f1f1;
            border: 1px solid #ccc;
            border-radius: 6px;
            padding: 0.4rem 0.8rem;
            font-size: 1.2rem;
            cursor: pointer;
            transition: background-color 0.3s;
        }

            .hamburguer-button:hover {
                background-color: #e2e2e2;
            }

        .navbar .d-flex.align-items-center {
            align-items: center;
        }

        .offcanvas {
            width: 250px;
            background-color: #3654ff;
            color: #fff;
            border-right: none;
            box-shadow: 2px 0 12px rgba(0,0,0,0.2);
        }

            .offcanvas .offcanvas-header {
                border-bottom: 1px solid rgba(255,255,255,0.2);
            }

            .offcanvas .offcanvas-title {
                color: #fff;
                font-weight: 600;
            }

            .offcanvas .btn-close {
                filter: invert(1);
            }

        .offcanvas-body {
            padding: 1rem 0.5rem;
        }

            .offcanvas-body ul {
                list-style: none;
                padding: 0;
                margin: 0;
            }

                .offcanvas-body ul li {
                    margin-bottom: 1rem;
                }

                    .offcanvas-body ul li a {
                        display: flex;
                        align-items: center;
                        gap: 0.5rem;
                        color: #fff;
                        text-decoration: none;
                        padding: 0.5rem 1rem;
                        border-radius: 6px;
                        transition: background-color 0.3s, transform 0.2s;
                    }

                        .offcanvas-body ul li a:hover {
                            background-color: rgba(255,255,255,0.15);
                            transform: translateX(5px);
                        }

                        .offcanvas-body ul li a i {
                            font-size: 1.2rem;
                        }

                        .offcanvas-body ul li a.dashboard i {
                            content: "\f0e4";
                        }

        @@media (max-width: 768px) {
            footer .container

        {
            flex-direction: column !important;
            align-items: flex-start; 
            gap: 10px; 
        }

        footer .container a {
            display: block; 
            margin-bottom: 5px;
        }

        footer .container div {
            margin-bottom: 10px;
        }

        }
    </style>
</head>
<body>
    <div class="content-wrapper">
        <header>
            <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom mb-3">
                <div class="container-fluid">
                    @{
                        var usuarioLogado = Context.Session.GetInt32("UsuarioId") != null;
                        var controllerLink = usuarioLogado ? "Dashboard" : "Home";
                    }

                    <a class="navbar-brand" asp-area="" asp-controller="@controllerLink" asp-action="Index">
                        <img src="~/imagens/controleFinanceiro.png" alt="Controle Financeiro">
                    </a>


                    <!-- Botões à direita -->
                    <div class="d-flex ms-auto align-items-center">
                        @{
                            var usuarioId = HttpContextAccessor.HttpContext.Session.GetInt32("UsuarioId");
                        }

                        @if (usuarioId != null)
                        {
                            <!-- Logout -->
                            <a href="/Account/Logout" class="login-navbar-button me-3">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0013.5 3H6.75A2.25 2.25 0 004.5 5.25v13.5A2.25 2.25 0 006.75 21h6.75a2.25 2.25 0 002.25-2.25V15m0-6l6 6m0 0l-6 6m6-6H9" />
                                </svg>
                                <div class="text">Logout</div>
                            </a>

                            <!-- Menu Hamburguer -->
                            <button class="hamburguer-button" type="button" data-bs-toggle="offcanvas" data-bs-target="#menuHamburguer">
                                ☰
                            </button>
                        }
                        else
                        {
                            <!-- Login / Cadastro com ícones -->
                            <a href="/Account/Register" class="login-navbar-button me-2">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14c-4.418 0-8 1.79-8 4v2h16v-2c0-2.21-3.582-4-8-4z" />
                                </svg>
                                <div class="text">Cadastro</div>
                            </a>
                            <a href="/Account/Login" class="login-navbar-button">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0013.5 3H6.75A2.25 2.25 0 004.5 5.25v13.5A2.25 2.25 0 006.75 21h6.75a2.25 2.25 0 002.25-2.25V15m0-6l6 6m0 0l-6 6m6-6H9" />
                                </svg>
                                <div class="text">Login</div>
                            </a>
                        }
                    </div>
                </div>
            </nav>

            <!-- Offcanvas menu -->
            @if (usuarioId != null)
            {
                <div class="offcanvas offcanvas-start" tabindex="-1" id="menuHamburguer">
                    <div class="offcanvas-header">
                        <h5 class="offcanvas-title">Menu</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
                    </div>
                    <div class="offcanvas-body">
                        <ul class="list-unstyled">
                            <li><a href="/Dashboard/Index" class="text-decoration-none">Dashboard</a></li>
                            <li><a href="/Transacao/Index" class="text-decoration-none">Minhas Transações</a></li>
                            <li><a href="/Transacao/Adicionar" class="text-decoration-none">Adicionar Transação</a></li>
                            <li><a href="/Fornecedor/Index" class="text-decoration-none">Fornecedores</a></li>
                        </ul>
                    </div>
                </div>
            }
        </header>

        <main class="container">
            @RenderBody()
        </main>

        <footer class="text-muted">
            <div class="container d-flex flex-column flex-md-row justify-content-between align-items-center">
                <div class="mb-2 mb-md-0">
                    &copy; 2025 - controleFinanceiro | Criado por
                    <a href="https://brunorba08.github.io/portfolio" target="_blank" style="text-decoration:none; color:inherit;">
                        <strong>Bruno Ribeiro</strong>
                    </a>
                </div>
                <div>
                    <a href="tel:+5511940072543" class="text-muted me-3">
                        <i class="bi bi-telephone-fill text-success"></i> +55 11 94007-2543
                    </a>
                    <a href="mailto:brunoribeiroba080803@gmail.com" class="text-muted me-3">
                        <i class="bi bi-envelope-fill text-danger"></i> brunoribeiroba080803@gmail.com
                    </a>
                    <a href="https://www.linkedin.com/in/bruno-ribeiro-a5b828192" target="_blank" class="text-muted">
                        <i class="bi bi-linkedin" style="color:#0a66c2;"></i> LinkedIn
                    </a>
                </div>
            </div>
        </footer>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
