@model ControleFinanceiro.Models.CompraFornecedor

<h2>Adicionar Compra</h2>

<form method="post" enctype="multipart/form-data">
    <input type="hidden" name="FornecedorId" value="@Model.FornecedorId" />

    <div class="mb-3">
        <label>Descrição</label>
        <input type="text" name="Descricao" class="form-control" required />
    </div>

    <div class="mb-3">
        <label>Valor</label>
        <input type="number" step="0.01" name="Valor" class="form-control" required />
    </div>

    <div class="mb-3">
        <label>Data</label>
        <input type="date" name="DataCompra" class="form-control" value="@Model.Data.ToString("yyyy-MM-dd")" required />
    </div>

    <div class="mb-3">
        <label>Foto (opcional)</label>
        <input type="file" name="Foto" class="form-control" />
    </div>

    <button type="submit" class="btn btn-success">Salvar</button>
</form>
