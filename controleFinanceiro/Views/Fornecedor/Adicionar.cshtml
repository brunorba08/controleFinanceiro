@model ControleFinanceiro.Models.Fornecedor

<h2>Adicionar Fornecedor</h2>

<form method="post">
    <div class="mb-3">
        <label>Nome</label>
        <input type="text" name="Nome" class="form-control" required />
    </div>
    <div class="mb-3">
        <label>Contato</label>
        <input type="text" name="NumeroContato" class="form-control" />
    </div>
    <button type="submit" class="btn btn-success">Salvar</button>
</form>
