@{
    ViewData["Title"] = "Cadastro";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.0/jquery.min.js">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/jquery.mask/1.14.16/jquery.mask.min.js">

<style>
    .cadastro-container {
        display: flex;
        justify-content: center;
        align-items: flex-start;
        padding: 40px 20px 70px 20px;
        gap: 60px;
        box-sizing: border-box;
    }

    /* Texto motivacional */
    .cadastro-text {
        width: 45%;
        font-size: 18px;
        color: #004080;
        line-height: 1.8; /* aumenta espaço entre linhas */
        margin-bottom: 20px;
    }

    /* Caixa do formulário */
    .cadastro-form {
        width: 45%; /* diminui o tamanho do formulário */
        background-color: white;
        padding: 30px 35px; /* diminui padding */
        border-radius: 10px;
        box-shadow: 0 0 15px rgba(0, 51, 102, 0.3);
        display: flex;
        flex-direction: column;
    }

        .cadastro-form h2 {
            text-align: center;
            margin-bottom: 25px;
            color: #004080;
        }

        .cadastro-form label {
            display: block;
            margin-bottom: 6px;
            font-weight: 600;
        }

        .cadastro-form input[type="text"],
        .cadastro-form input[type="email"],
        .cadastro-form input[type="password"],
        .cadastro-form input[type="tel"] {
            width: 100%;
            padding: 10px 12px;
            margin-bottom: 20px;
            border: 1.8px solid #004080;
            border-radius: 5px;
            font-size: 14px;
            transition: border-color 0.3s ease;
        }

        .cadastro-form input:focus {
            border-color: #007bff;
            outline: none;
        }

    .cadastro-btn {
        width: 100%;
        background-color: #0059b3;
        color: white;
        font-weight: 700;
        padding: 12px 0;
        border: none;
        border-radius: 5px;
        font-size: 16px;
        cursor: pointer;
        transition: background-color 0.3s ease;
    }

        .cadastro-btn:hover {
            background-color: #003d7a;
        }

    .cadastro-form .custom-control {
        position: relative;
        width: 100%;
        margin-bottom: 25px;
    }

        .cadastro-form .custom-control .input-wrapper {
            position: relative;
            width: 100%;
        }

        .cadastro-form .custom-control input {
            background-color: transparent;
            border: 0;
            border-bottom: 2px #004080 solid;
            width: 100%;
            padding: 15px 35px 15px 30px;
            font-size: 16px;
            color: #004080;
        }

            .cadastro-form .custom-control input:focus,
            .cadastro-form .custom-control input:valid {
                outline: 0;
                border-bottom-color: #007bff;
            }

        .cadastro-form .custom-control label {
            position: absolute;
            top: 15px;
            left: 30px;
            pointer-events: none;
        }

            .cadastro-form .custom-control label span {
                display: inline-block;
                font-size: 16px;
                min-width: 5px;
                color: #004080;
                transition: 0.3s cubic-bezier(0.68, -0.55, 0.265, 1.55);
            }

        .cadastro-form .custom-control input:focus + label span,
        .cadastro-form .custom-control input:valid + label span {
            color: #007bff;
            transform: translateY(-30px);
        }

        .cadastro-form .custom-control i.left-icon {
            position: absolute;
            top: 50%;
            left: 0;
            transform: translateY(-50%);
            color: #004080;
            font-size: 18px;
        }

        .cadastro-form .custom-control i.eye-icon {
            position: absolute;
            top: 50%;
            right: 0;
            transform: translateY(-50%);
            color: #004080;
            font-size: 18px;
            cursor: pointer;
            z-index: 2;
        }

    .cadastro-image {
        width: 80%;
        margin-top: 20px;
        text-align: center;
    }

        .cadastro-image img {
            max-width: 100%;
            height: auto;
            border-radius: 10px;
        }
    @@media (max-width: 768px) {
        .cadastro-text

    {
        display: none;
    }

    .cadastro-container {
        justify-content: center;
        padding: 20px;
    }

    .cadastro-form {
        width: 100%; 
        padding: 20px;
        min-width: auto;
    }

    }
</style>

<div class="cadastro-container">
    <div class="cadastro-text">
        <h3>Você está a um passo de organizar sua vida!</h3>
        <p>
            Ao se cadastrar, você terá acesso a um sistema completo para controlar suas finanças de forma prática e segura.
            Organize suas contas, acompanhe seus gastos, planeje seu orçamento e tome decisões financeiras mais inteligentes.
            Preencha os campos abaixo e comece agora mesmo a transformar sua rotina financeira!
        </p>

        <div class="cadastro-image">
            <img src="~/imagens/formulario.png" alt="Controle Financeiro">
        </div>
    </div>

    <form class="cadastro-form" method="post" action="/Account/Register" onsubmit="return validarSenha()">
        <h2>Faça seu cadastro!</h2>

        <!-- NOME -->
        <div class="custom-control">
            <i class="bi bi-person-fill left-icon"></i>
            <input type="text" name="Nome" required />
            <label>
                <span style="transition-delay:0ms">N</span>
                <span style="transition-delay:50ms">o</span>
                <span style="transition-delay:100ms">m</span>
                <span style="transition-delay:150ms">e</span>
                <span style="transition-delay:200ms">:</span>
            </label>
        </div>

        <!-- EMAIL -->
        <div class="custom-control">
            <i class="bi bi-envelope-fill left-icon"></i>
            <input type="email" name="Email" required />
            <label>
                <span style="transition-delay:0ms">E</span>
                <span style="transition-delay:50ms">m</span>
                <span style="transition-delay:100ms">a</span>
                <span style="transition-delay:150ms">i</span>
                <span style="transition-delay:200ms">l</span>
                <span style="transition-delay:250ms">:</span>
            </label>
        </div>

        <!-- TELEFONE -->
        <div class="custom-control">
            <i class="bi bi-telephone-fill left-icon"></i>
            <input type="tel" id="telefone" name="Telefone"  maxlength="11" required />
            <label>
                <span style="transition-delay:0ms">T</span>
                <span style="transition-delay:50ms">e</span>
                <span style="transition-delay:100ms">l</span>
                <span style="transition-delay:150ms">e</span>
                <span style="transition-delay:200ms">f</span>
                <span style="transition-delay:250ms">o</span>
                <span style="transition-delay:300ms">n</span>
                <span style="transition-delay:350ms">e</span>
                <span style="transition-delay:400ms">:</span>
            </label>
        </div>

        <!-- SENHA -->
        <div class="custom-control">
            <i class="bi bi-lock-fill left-icon"></i>
            <div class="input-wrapper" style="position: relative;">
                <input type="password" id="senha" name="Senha" required />
                <label>
                    <span style="transition-delay:0ms">S</span>
                    <span style="transition-delay:50ms">e</span>
                    <span style="transition-delay:100ms">n</span>
                    <span style="transition-delay:150ms">h</span>
                    <span style="transition-delay:200ms">a</span>
                    <span style="transition-delay:250ms">:</span>
                </label>
                <i class="bi bi-eye eye-icon" id="toggleSenha"></i>
            </div>
        </div>

        <!-- CONFIRMAR SENHA -->
        <div class="custom-control">
            <i class="bi bi-lock-fill left-icon"></i>
            <div class="input-wrapper" style="position: relative;">
                <input type="password" id="confirmarSenha" required />
                <label>
                    <span style="transition-delay:0ms">C</span>
                    <span style="transition-delay:50ms">o</span>
                    <span style="transition-delay:100ms">n</span>
                    <span style="transition-delay:150ms">f</span>
                    <span style="transition-delay:200ms">i</span>
                    <span style="transition-delay:250ms">r</span>
                    <span style="transition-delay:300ms">m</span>
                    <span style="transition-delay:350ms">a</span>
                    <span style="transition-delay:400ms">r</span>
                    <span style="transition-delay:450ms">:</span>
                </label>
                <i class="bi bi-eye eye-icon" id="toggleConfirmarSenha"></i>
            </div>
        </div>

        <button type="submit" class="cadastro-btn">Cadastrar</button>
    </form>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.0/jquery.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery.mask/1.14.16/jquery.mask.min.js"></script>
<script>
 

    function validarSenha() {
        var senha = document.getElementById("senha").value;
        var confirmar = document.getElementById("confirmarSenha").value;
        var telefone = document.getElementById("telefone").value.replace(/\D/g,'');

        if (senha !== confirmar) {
            alert("As senhas não coincidem!");
            return false;
        }

        if (telefone.length !== 11) {
            alert("Digite um número de telefone válido com 11 dígitos.");
            return false;
        }

        return true;
    }

        document.getElementById('toggleSenha').addEventListener('click', function() {
        const input = document.getElementById('senha');
        this.classList.toggle('bi-eye-slash');
        this.classList.toggle('bi-eye');
        input.type = input.type === 'password' ? 'text' : 'password';
    });

    document.getElementById('toggleConfirmarSenha').addEventListener('click', function() {
        const input = document.getElementById('confirmarSenha');
        this.classList.toggle('bi-eye-slash');
        this.classList.toggle('bi-eye');
        input.type = input.type === 'password' ? 'text' : 'password';
    });


    // Alert de sucesso após cadastro
    @if (TempData["Sucesso"] != null)
    {
            <text>
                alert("@TempData["Sucesso"]");
            </text>
    }
</script>
