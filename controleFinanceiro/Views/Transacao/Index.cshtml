@using System.Text.Json
@model List<ControleFinanceiro.Models.Transacao>

@{
    // Se Model for null, inicializa lista vazia
    var transacoes = Model ?? new List<ControleFinanceiro.Models.Transacao>();

    // Calcula total de ganhos e despesas de forma segura
    var totalGanho = transacoes.Where(t => t.Tipo == "Ganho").Sum(t => t.Valor);
    var totalDespesa = transacoes.Where(t => t.Tipo == "Despesa").Sum(t => t.Valor);
    var saldo = totalGanho - totalDespesa;

    // Datas para filtro (ViewBag pode ser null)
    var dataInicial = ViewBag.DataInicial as DateTime? ?? DateTime.Today;
    var dataFinal = ViewBag.DataFinal as DateTime? ?? DateTime.Today;
}

<div class="container">
    <h2>Resumo Diário</h2>

    <!-- Filtro por intervalo de datas -->
    <form method="get" asp-action="ResumoDiario" class="d-flex mb-3">
        <input type="date" name="dataInicial" value="@dataInicial.ToString("yyyy-MM-dd")" class="form-control me-2" />
        <input type="date" name="dataFinal" value="@dataFinal.ToString("yyyy-MM-dd")" class="form-control me-2" />
        <button type="submit" class="btn btn-primary">Filtrar</button>
    </form>

    <!-- Botões de adicionar transação -->
    <div class="mb-4 text-center">
        <a href="/Transacao/Adicionar?tipo=Ganho" class="btn btn-success me-2">
            <i class="bi bi-plus-circle"></i> Adicionar Ganho
        </a>
        <a href="/Transacao/Adicionar?tipo=Despesa" class="btn btn-danger">
            <i class="bi bi-dash-circle"></i> Adicionar Despesa
        </a>
    </div>

    <!-- Resumo valores -->
    <div class="row mb-4">
        <div class="col-md-12 text-center">
            <h5>Total Ganhos: <span class="text-success">@totalGanho.ToString("C")</span></h5>
            <h5>Total Despesas: <span class="text-danger">@totalDespesa.ToString("C")</span></h5>
            <h5>Saldo: <span>@saldo.ToString("C")</span></h5>
        </div>
    </div>

    <!-- Gráfico e Histórico lado a lado -->
    <div class="row">
        <div class="col-md-6">
            <h5 class="text-center">Gráfico</h5>
            <canvas id="graficoResumo"></canvas>
        </div>

        <div class="col-md-6">
            <h5 class="text-center">Histórico do Dia</h5>
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Tipo</th>
                        <th>Descrição</th>
                        <th>Valor</th>
                        <th>Hora</th>
                        <th>Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in transacoes)
                    {
                        <tr>
                            <td>@t.Tipo</td>
                            <td>@t.Descricao</td>
                            <td class="@(t.Tipo == "Ganho" ? "text-success" : "text-danger")">
                                @(t.Tipo == "Ganho" ? "+" : "-") @t.Valor.ToString("C")
                            </td>
                            <td>@t.Data.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>
                                <a href="/Transacao/Editar/@t.Id" class="btn btn-warning btn-sm me-1">
                                    <i class="bi bi-pencil-square"></i> Editar
                                </a>
                                <form asp-action="Excluir" asp-controller="Transacao" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@t.Id" />
                                    <button type="submit" class="btn btn-danger btn-sm">
                                        <i class="bi bi-trash"></i> Excluir
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Chart.js -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    const labels = @Html.Raw(JsonSerializer.Serialize(transacoes.Select(t => t.Data.ToString("HH:mm"))));
    const ganhos = @Html.Raw(JsonSerializer.Serialize(transacoes.Select(t => t.Tipo == "Ganho" ? t.Valor : 0)));
    const despesas = @Html.Raw(JsonSerializer.Serialize(transacoes.Select(t => t.Tipo == "Despesa" ? t.Valor : 0)));

    const ctx = document.getElementById('graficoResumo').getContext('2d');
    new Chart(ctx, {
        type: 'line',
        data: {
            labels: labels,
            datasets: [
                {
                    label: 'Ganhos',
                    data: ganhos,
                    borderColor: '#28a745',
                    backgroundColor: 'rgba(40,167,69,0.2)',
                    tension: 0.3,
                    fill: true
                },
                {
                    label: 'Despesas',
                    data: despesas,
                    borderColor: '#dc3545',
                    backgroundColor: 'rgba(220,53,69,0.2)',
                    tension: 0.3,
                    fill: true
                }
            ]
        },
        options: {
            responsive: true,
            plugins: {
                legend: { position: 'top' },
                title: { display: true, text: 'Ganhos vs Despesas Hoje' }
            },
            scales: {
                y: { beginAtZero: true }
            }
        }
    });
</script>
