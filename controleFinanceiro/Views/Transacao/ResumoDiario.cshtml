@using System.Text.Json
@model List<ControleFinanceiro.Models.Transacao>

@{
    var transacoes = Model ?? new List<ControleFinanceiro.Models.Transacao>();

    var totalGanho = transacoes.Where(t => t.Tipo == "Ganho").Sum(t => t.Valor);
    var totalDespesa = transacoes.Where(t => t.Tipo == "Despesa").Sum(t => t.Valor);
    var saldo = totalGanho - totalDespesa;

    var dataInicial = ViewBag.DataInicial as DateTime? ?? DateTime.Today;
    var dataFinal = ViewBag.DataFinal as DateTime? ?? DateTime.Today;
}

<div class="container">
    <h2>Resumo Diário</h2>

    <!-- Filtro por intervalo de datas -->
    <form method="get" asp-action="ResumoDiario" class="d-flex mb-3">
        <input type="date" name="dataInicial" value="@dataInicial.ToString("yyyy-MM-dd")" class="form-control me-2" />
        <input type="date" name="dataFinal" value="@dataFinal.ToString("yyyy-MM-dd")" class="form-control me-2" />
        <button type="submit" class="btn btn-primary">Filtrar</button>
    </form>

    <!-- Resumo valores -->
    <div class="row mb-4 text-center">
        <div class="col-md-12">
            <h5>Total Ganhos: <span class="text-success">@totalGanho.ToString("C")</span></h5>
            <h5>Total Despesas: <span class="text-danger">@totalDespesa.ToString("C")</span></h5>
            <h5>Saldo: <span>@saldo.ToString("C")</span></h5>
        </div>
    </div>

    <!-- Gráfico e Histórico -->
    <div class="row">
        <div class="col-md-6">
            <canvas id="graficoResumo"></canvas>
        </div>
        <div class="col-md-6">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Tipo</th>
                        <th>Descrição</th>
                        <th>Valor</th>
                        <th>Hora</th>
                        <th>Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in transacoes)
                    {
                        <tr>
                            <td>@t.Tipo</td>
                            <td>@t.Descricao</td>
                            <td class="@(t.Tipo == "Ganho" ? "text-success" : "text-danger")">
                                @(t.Tipo == "Ganho" ? "+" : "-") @t.Valor.ToString("C")
                            </td>
                            <td>@t.Data.ToString("HH:mm")</td>
                            <td>
                                <a href="/Transacao/Editar/@t.Id" class="btn btn-warning btn-sm">Editar</a>
                                <form asp-action="Excluir" asp-controller="Transacao" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@t.Id" />
                                    <button type="submit" class="btn btn-danger btn-sm">Excluir</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    const labels = @Html.Raw(JsonSerializer.Serialize(transacoes.Select(t => t.Data.ToString("HH:mm"))));
    const ganhos = @Html.Raw(JsonSerializer.Serialize(transacoes.Select(t => t.Tipo == "Ganho" ? t.Valor : 0)));
    const despesas = @Html.Raw(JsonSerializer.Serialize(transacoes.Select(t => t.Tipo == "Despesa" ? t.Valor : 0)));

    new Chart(document.getElementById('graficoResumo').getContext('2d'), {
        type: 'line',
        data: {
            labels: labels,
            datasets: [
                { label: 'Ganhos', data: ganhos, borderColor: '#28a745', backgroundColor: 'rgba(40,167,69,0.2)', tension:0.3, fill:true },
                { label: 'Despesas', data: despesas, borderColor: '#dc3545', backgroundColor: 'rgba(220,53,69,0.2)', tension:0.3, fill:true }
            ]
        },
        options: { responsive:true, plugins:{ legend:{position:'top'}, title:{display:true,text:'Ganhos vs Despesas'} }, scales:{ y:{beginAtZero:true} } }
    });
</script>
