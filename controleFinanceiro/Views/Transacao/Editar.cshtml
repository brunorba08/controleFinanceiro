@model ControleFinanceiro.Models.Transacao

<h2>Editar Transação</h2>

<form method="post">
    <div class="mb-3">
        <label>Descrição</label>
        <input type="text" name="Descricao" class="form-control" value="@Model.Descricao" required />
    </div>
    <div class="mb-3">
        <label>Valor</label>
        <input type="number" name="Valor" class="form-control" value="@Model.Valor" step="0.01" required />
    </div>
    <div class="form-group">
        <label>Tipo:</label>
        @Html.DropDownListFor(model => model.Tipo,
        new List<SelectListItem> {
                new SelectListItem { Text = "Ganho", Value = "Ganho", Selected = Model.Tipo == "Ganho" },
                new SelectListItem { Text = "Despesa", Value = "Despesa", Selected = Model.Tipo == "Despesa" }
                },
                new { @class = "form-control" })
    </div>
    <div class="mb-3">
        <label>Data</label>
        <input type="date" name="Data" class="form-control" value="@Model.Data.ToString("yyyy-MM-dd")" required />
    </div>
    <button type="submit" class="btn btn-primary">Salvar Alterações</button>
</form>
